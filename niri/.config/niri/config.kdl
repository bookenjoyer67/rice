
input {
    keyboard {
        xkb {
        }
        numlock
    }
    mouse {
      accel-speed 1.0
    }

    touchpad {
        tap
        natural-scroll
    }

    focus-follows-mouse max-scroll-amount="0%"
}

output "eDP-1" {
    mode "1920x1080@144.023"
    scale 1.0
    position x=0 y=0
    focus-at-startup            // laptop panel is the primary output
}

output "HDMI-A-1" {
    mode "1360x768@60.015"
    scale 1.0
    position x=1920 y=0
}

debug {
    wait-for-frame-completion-before-queueing
}

layer-rule {
    match namespace="^awww-daemon$"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-backdrop$"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-desktop-widget-"
    place-within-backdrop true
}

layout {
    gaps 6
    center-focused-column "never"
    always-center-single-column
    background-color "transparent"

    default-column-width { proportion 0.33333; }

    preset-column-widths {
        proportion 0.25
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.75
        proportion 1.0
    }

    focus-ring {
        width 3
        active-color "#FF46A2"      // catppuccin mocha blue
        inactive-color "#480024"    // catppuccin mocha surface0
    }

    border {
        off
    }

    shadow {
            on
            draw-behind-window true
            softness 30
            spread 5
            offset x=0 y=5
            color "#421f"
            
        }
}
overview {
    workspace-shadow {
        off
    }
    zoom 0.45
}

blur {
    passes 2
    noise 0.0001
    saturation 3
}

animations {
    window-open {
        spring damping-ratio=0.6 stiffness=650 epsilon=0.0001
    }
    window-close {
        spring damping-ratio=0.7 stiffness=750 epsilon=0.0001
    }
    workspace-switch {
      spring damping-ratio=0.75 stiffness=100 epsilon=0.0001
    }
    horizontal-view-movement {
      spring damping-ratio=0.75 stiffness=100 epsilon=0.0001
    }
    window-resize {
      spring damping-ratio=0.70 stiffness=100 epsilon=0.0001
    }
}

cursor {
    xcursor-theme "Bibata-Rainbow-Modern"
    xcursor-size 24
    hide-after-inactive-ms 1000
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

spawn-at-startup "sh" "-c" "LD_PRELOAD=\"$HOME/.local/lib/noctalia-layer-swap.so\" exec noctalia"
spawn-at-startup "bash" "-c" "$HOME/.config/niri/scripts/start-wallpaper-one.sh"   // awww daemon + re-paint the CURRENT wallpaper at startup (no new image; rotation DISABLED, user switches manually)
spawn-at-startup "bash" "-c" "$HOME/.config/niri/scripts/wallpaper-hotplug.sh"     // re-paint wallpaper on monitors that (re)connect after startup (e.g. the flapping HDMI TV)
spawn-at-startup "bash" "-c" "exec $HOME/.local/bin/wallpaper-bars-gpu >>$HOME/.cache/wallpaper-bars-gpu.log 2>&1"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-at-startup "wlsunset" "-l" "38.6" "-L" "-90.2" "-T" "6500" "-t" "4000"

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}
window-rule {
    match app-id="^pavucontrol$"
    open-floating true
}
window-rule {
    match app-id="^org.waytray.Client$"
    open-floating true
}
window-rule {
    match app-id="^nm-connection-editor$"
    open-floating true
}
window-rule {
    match app-id="^polkit-gnome-authentication-agent-1$"
    open-floating true
}
window-rule {
    match app-id="^org.gnome.Calculator$"
    open-floating true
}
window-rule {
    match app-id="^xdg-desktop-portal-gtk$"
    open-floating true
}
window-rule {
    match app-id="^kitty$"
    draw-border-with-background false
    shadow {
        on
        softness 4
        spread 1
        offset x=0 y=2
        color "#421f4466"
        draw-behind-window true
    }
}
window-rule {
    match app-id="^brave-browser$"
    draw-border-with-background false
    shadow {
      on
    }
}
window-rule {
    match app-id="^brave-origin$"
    draw-border-with-background false
    shadow {
      on
    }
}
window-rule {
    match is-active=false
    opacity 0.95
    shadow {
      on
      softness 4
      spread 1
      offset x=0 y=2
      color "#421f4466"
      draw-behind-window true
    }
}
window-rule {
    match app-id="^steam$"
    geometry-corner-radius 12
    clip-to-geometry true
    opacity 0.95
    draw-border-with-background false
    shadow {
        on
        softness 38
        spread 7
        offset x=0 y=5
        color "#421f4477"
        draw-behind-window true
    }
    background-effect {
        blur true
    }
}
window-rule {
    match app-id="^steam$" is-active=false
    opacity 0.90
    draw-border-with-background false
    background-effect {
        blur true
    }
}
window-rule {
    match app-id="^org.gnome.Nautilus$"
    opacity 1.0
    geometry-corner-radius 12
    draw-border-with-background false
    shadow {
        on
        softness 38
        spread 7
        offset x=0 y=5
        color "#421f4477"
        draw-behind-window true
    }
    background-effect {
        blur true
    }
}

binds {
    Mod+Return { spawn "kitty"; }                          // terminal (SUPER+Enter)
    Mod+SPACE { spawn-sh "noctalia msg panel-toggle launcher"; }   // app launcher (Noctalia)
    Mod+E { spawn "nautilus"; }                            // file manager
    Mod+Shift+S { spawn-sh "bash ~/.config/niri/scripts/search-selection.sh"; }  // search highlighted text

    Mod+Q { close-window; }
    Mod+F { fullscreen-window; }
    Mod+Shift+F { toggle-window-floating; }                // tiling <-> floating
    Mod+M { maximize-window-to-edges; }

    Mod+A { focus-column-left; }
    Mod+D { focus-column-right; }
    Mod+S { focus-window-or-workspace-down; }   // down through windows, spills to next workspace
    Mod+W { focus-window-or-workspace-up; }     // up through windows, spills to prev workspace
    Mod+WheelScrollUp { focus-window-or-workspace-up; }
    Mod+WheelScrollDown { focus-window-or-workspace-down; }

    Mod+Alt+A { focus-monitor-left; }
    Mod+Alt+D { focus-monitor-right; }

    Mod+Ctrl+A { move-column-left; }
    Mod+Ctrl+D { move-column-right; }
    Mod+Ctrl+S { move-window-down-or-to-workspace-down; }   // move window down, to next workspace at edge
    Mod+Ctrl+W { move-window-up-or-to-workspace-up; }       // move window up, to prev workspace at edge

    Mod+Ctrl+Shift+A { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+D { move-column-to-monitor-right; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Minus { set-column-width "-1%"; }
    Mod+Shift+Minus { set-column-width "-5%"; }
    Mod+Shift+Equal { set-column-width "+5%"; }
    Mod+Equal { set-column-width "+1%"; }

    Mod+Shift+J { move-window-to-workspace-down; }   // move window a workspace down
    Mod+Shift+K { move-window-to-workspace-up; }     // move window a workspace up
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Tab { toggle-overview; }                           // GNOME-ish overview (was hyprexpose)

    Mod+Shift+L { spawn-sh "exec $HOME/.local/bin/lock.sh"; }  // lock screen (swaylock ring, SUPER+SHIFT+L)
    Mod+Shift+E { spawn-sh "noctalia msg panel-toggle session"; }   // logout/power menu
    Mod+N { spawn-sh "noctalia msg panel-toggle control-center notifications"; }   // notifications (Noctalia)
    Mod+Shift+V { spawn-sh "noctalia msg panel-toggle clipboard"; }  // clipboard history
    Mod+Shift+W { spawn-sh "bash ~/.config/niri/scripts/random-wallpaper.sh"; }  // force random wallpaper (Tinder "keep")
    Mod+Shift+B { spawn-sh "noctalia msg panel-toggle computing/wallpaper-browser:browser"; }  // browse wallpapers by hand (wallhaven)
    Mod+Ctrl+Shift+X { spawn-sh "bash ~/.config/niri/scripts/swipe-delete-wallpaper.sh"; }  // BAN current wallpaper (Tinder "reject") — 4 keys on purpose: Mod+X was too easy to hit by accident
    Mod+Y { spawn-sh "noctalia msg panel-toggle aabidk20/yt-music:panel"; }  // YouTube Music panel (Noctalia plugin)

    Mod+B { spawn-sh "bash ~/.config/niri/scripts/toggle-wallpaper-bars.sh"; }

    Print { screenshot; }                                  // screenshot UI (region / pick)
    Mod+P { screenshot; }                                  // same, for laptops with no Print key
    Mod+Print { screenshot-screen; }                       // full screen, no UI
    Shift+Print { screenshot-window; }                     // focused window, no UI

    Mod+Shift+Ctrl+R { spawn-sh "bash ~/.config/niri/scripts/record-screen.sh"; }  // start/stop recording focused output + desktop audio -> ~/Videos/Recordings

    Ctrl+Alt+Delete { quit; }                              // quit (confirmation dialog)
    Mod+Shift+P { power-off-monitors; }

    Mod+Shift+Slash { show-hotkey-overlay; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "brightnessctl set 5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl set 5%-"; }
}

include optional=true "./focus-ring.kdl"

include optional=true "./animations.kdl"

include "noctalia.kdl"
