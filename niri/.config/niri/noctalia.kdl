layout {

    focus-ring {
        active-color   "#e5666a"
        inactive-color "#291415"
        urgent-color   "#e45e62"
    }

    border {
        active-color   "#e5666a"
        inactive-color "#291415"
        urgent-color   "#e45e62"
    }


    tab-indicator {
        active-color   "#e5666a"
        inactive-color "#861316"
        urgent-color   "#e45e62"
    }

    insert-hint {
        color "#e5666a80"
    }
}

recent-windows {
    highlight {
        active-color "#e5666a"
        urgent-color "#e45e62"
    }
}
