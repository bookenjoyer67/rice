layout {

    focus-ring {
        active-color   "#e46774"
        inactive-color "#271618"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#e46774"
        inactive-color "#271618"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#e46774"
        inactive-color "#85141f"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#e4677480"
    }
}

recent-windows {
    highlight {
        active-color "#e46774"
        urgent-color "#fd4663"
    }
}
