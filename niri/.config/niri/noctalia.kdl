layout {

    focus-ring {
        active-color   "#e47e67"
        inactive-color "#291814"
        urgent-color   "#d25a3f"
    }

    border {
        active-color   "#e47e67"
        inactive-color "#291814"
        urgent-color   "#d25a3f"
    }


    tab-indicator {
        active-color   "#e47e67"
        inactive-color "#852814"
        urgent-color   "#d25a3f"
    }

    insert-hint {
        color "#e47e6780"
    }
}

recent-windows {
    highlight {
        active-color "#e47e67"
        urgent-color "#d25a3f"
    }
}
