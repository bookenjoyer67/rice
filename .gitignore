# --- local-only working copies: kept out of the repo ------------------------------
# yambar: nothing draws a bar in this rice, but matugen's palette dump
# (~/.config/yambar/colors.yml) is read by lock.sh, and matugen's post_hook calls
# theme-reload.sh. Those two support files DO ship; the actual bar config and its
# per-monitor scripts are local-only.
yambar/.config/yambar/*
!yambar/.config/yambar/theme-reload.sh
!yambar/.config/yambar/colors.fallback.yml
eww/
wofi/

# --- editor / live-edit leftovers -------------------------------------------------
*.bak
*.bak-*
*.bak.*
*.old
.backup-*
*~

# stray experiment config kept in the working tree but not part of the rice
niri/.config/niri/4

# absolute symlink into ~/.cache (points at /home/computing, regenerated per wallpaper)
backgrounds/.config/backgrounds/current-wallpaper

# --- secrets: must never land in a shared repo ------------------------------------
.env
.env.*
*.token
.cf-token
*.pem
id_rsa*

# --- junk -------------------------------------------------------------------------
.DS_Store
*.swp
*~
__pycache__/
*.pyc
