layout {

    focus-ring {
        active-color   "#f85357"
        inactive-color "#291414"
        urgent-color   "#f73136"
    }

    border {
        active-color   "#f85357"
        inactive-color "#291414"
        urgent-color   "#f73136"
    }


    tab-indicator {
        active-color   "#f85357"
        inactive-color "#930509"
        urgent-color   "#f73136"
    }

    insert-hint {
        color "#f8535780"
    }
}

recent-windows {
    highlight {
        active-color "#f85357"
        urgent-color "#f73136"
    }
}
