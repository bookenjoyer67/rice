{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/home/computing/.config/fastfetch/logo.png",
    "width": 14,
    "padding": {
      "top": 1,
      "right": 2
    },
    "color": {
      "1": "#bf63e4",
      "2": "#fb6e37"
    }
  },
  "display": {
    "separator": " :: ",
    "color": {
      "keys": "#bf67e4",
      "title": "#fb6e37",
      "output": "#00FFFF",
      "separator": "#FF1493"
    },
    "brightColor": true,
    "percent": {
      "color": {
        "green": "#cc6684",
        "yellow": "#d193ec",
        "red": "#e24305"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#00FFFF",
        "at": "#FF1493",
        "host": "#39FF14"
      }
    },
    {
      "type": "separator",
      "string": " ─ ",
      "outputColor": "#FF1493"
    },
    {
      "type": "os"
    },
    {
      "type": "host"
    },
    {
      "type": "kernel"
    },
    {
      "type": "uptime"
    },
    {
      "type": "packages"
    },
    {
      "type": "shell"
    },
    {
      "type": "wm"
    },
    {
      "type": "disk",
      "folders": [
        "/"
      ],
      "format": "{size-used}/{size-total} ({size-percentage})"
    },
    {
      "type": "terminal"
    },
    {
      "type": "cpu",
      "format": "{cores-logical}T @ {freq-max}"
    },
    {
      "type": "gpu",
      "format": "{name}"
    },
    {
      "type": "memory"
    },
    {
      "type": "separator",
      "string": " ─ ",
      "outputColor": "#FF1493"
    },
    {
      "type": "colors",
      "paddingLeft": 4
    }
  ]
}
