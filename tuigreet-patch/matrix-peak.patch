+/// Convert a hue (degrees) into a fully saturated RGB colour, darkened for
+/// the fading tail of a stream.
+fn hue_rgb(hue: f32, dim: bool) -> Color {
+  let h = hue.rem_euclid(360.0) / 60.0;
+  let sat = if dim { 0.70 } else { 1.0 };
+  let val = if dim { 0.45 } else { 1.0 };
+
+  let c = val * sat;
+  let x = c * (1.0 - ((h % 2.0) - 1.0).abs());
+  let (r, g, b) = match h as u32 {
+    0 => (c, x, 0.0),
+    1 => (x, c, 0.0),
+    2 => (0.0, c, x),
+    3 => (0.0, x, c),
+    4 => (x, 0.0, c),
+    _ => (c, 0.0, x),
+  };
+  let m = val - c;
+  let to_u8 = |v: f32| ((v + m) * 255.0).clamp(0.0, 255.0) as u8;
+  Color::Rgb(to_u8(r), to_u8(g), to_u8(b))
+}
