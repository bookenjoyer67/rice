// Auto-generated by Noctalia - do not edit by hand.
//
// niri focus-ring ("selection ring") colours, sampled from the wallpaper.
// Rendered by the Noctalia user template declared in
// ~/.config/noctalia/templates.toml ([theme.templates.user.niri-focus-ring])
// every time the shell palette changes, so the ring can never drift from the
// bar/panels/eww palette.
//
// Included LAST from config.kdl (include optional=true "./focus-ring.kdl"):
// niri includes are positional and merge field-by-field, so this block
// overrides only the focus-ring colours and leaves width/colours elsewhere
// alone. Gradients take precedence over the solid active-color/inactive-color.
layout {
    focus-ring {
        // Active window: primary -> tertiary, the same two accents the shell
        // uses for highlights. 45deg mirrors CSS linear-gradient(45deg, ...).
        active-gradient from="{{colors.primary.default.hex}}" to="{{colors.tertiary.default.hex}}" angle=45
        // Unfocused windows (only visible on other outputs): a quiet
        // wallpaper-derived pair so the ring still belongs to the palette.
        inactive-gradient from="{{colors.surface_variant.default.hex}}" to="{{colors.outline_variant.default.hex}}" angle=45
    }
}
